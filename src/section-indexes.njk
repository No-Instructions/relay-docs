---
layout: doc.njk
pagination:
  data: sections
  size: 1
  alias: section
  addAllPagesToCollections: true
permalink: "/{{ section.path }}/"
eleventyComputed:
  title: "{{ section.title }}"
  description: "{{ section.outcome or ('Browse ' + (section.title | lower) + ' documentation for Relay.') }}"
  ogSlug: "{{ section.path.split('/') | last }}"
---
{%- macro card(item) -%}
{%- set target = collections.all | pageAtPath(item.path) -%}
<li><a class="section-card" href="/{{ item.path }}/">
  <span class="section-card-title">{{ target.data.title if target else item.title }}</span>
  {%- if target and target.data.description %}
  <span class="section-card-description">{{ target.data.description }}</span>
  {%- endif %}
</a></li>
{%- endmacro -%}

{%- if section.kind == 'guide' -%}

{%- if section.outcome %}
<p class="guide-outcome">{{ section.outcome }}</p>
{%- endif %}
{%- if section.video %}
<figure class="guide-video">
  <video controls playsinline preload="metadata" poster="{{ section.video.poster }}">
    <source src="{{ section.video.webm }}" type="video/webm">
    <source src="{{ section.video.mp4 }}" type="video/mp4">
    <a href="{{ section.video.mp4 }}">Download the video</a>.
  </video>
  <figcaption>{{ section.video.caption }}</figcaption>
</figure>
{%- endif %}
{%- if section.paths %}
<ul class="section-cards guide-paths" role="list">
{%- for path in section.paths %}
  <li><a class="section-card" href="{{ path.href }}">
    <span class="section-card-title">{{ path.title }}</span>
    <span class="section-card-description">{{ path.description }}</span>
  </a></li>
{%- endfor %}
</ul>
{%- endif %}
{%- set listTag = 'ol' if section.ordered else 'ul' %}
<{{ listTag }} id="guides" class="guide-steps{% if not section.ordered %} guide-steps-unordered{% endif %}" role="list">
{%- for item in section.pages %}
{%- set target = collections.all | pageAtPath(item.path) %}
  <li>
    <p class="guide-step-title"><a href="/{{ item.path }}/">{{ target.data.title if target else item.title }}</a></p>
    {%- if target and target.data.description %}
    <p>{{ target.data.description }}</p>
    {%- endif %}
  </li>
{%- endfor %}
</{{ listTag }}>

{%- else -%}

{%- set leaves = [] -%}
{%- set subgroups = [] -%}
{%- for item in section.pages -%}
  {%- if item.children -%}{%- set subgroups = (subgroups.push(item), subgroups) -%}
  {%- else -%}{%- set leaves = (leaves.push(item), leaves) -%}{%- endif -%}
{%- endfor -%}

{%- for group in subgroups %}
<h2 id="{{ group.path.split('/') | last }}"><a href="/{{ group.path }}/">{{ group.title }}</a></h2>
<ul class="section-cards" role="list">
{%- for child in group.children %}
  {{ card(child) }}
{%- endfor %}
</ul>
{%- endfor %}

{%- if leaves.length %}
{%- if subgroups.length %}
<h2 id="more">More</h2>
{%- endif %}
<ul class="section-cards" role="list">
{%- for item in leaves %}
  {{ card(item) }}
{%- endfor %}
</ul>
{%- endif %}

{%- endif %}
