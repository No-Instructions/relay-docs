{% extends "base.njk" %}

{# Render the TOC and count total entries (top-level + nested) via the
   plugin's own parser. The total-entry rule means a page with 1 H2 +
   many H3 children still renders the rail — see eleventy review fix. #}
{% set tocHtml = content | toc %}
{% set tocEntryCount = content | tocEntryCount %}
{% set showToc = tocEntryCount >= 2 %}

{% block bodyClass %}{% if not showToc %}no-toc{% endif %}{% endblock %}

{% block content %}
<div class="layout">
  <nav class="sidebar has-docs-edition" aria-label="Documentation navigation">
    {% include "edition-label.njk" %}
    <button class="docs-nav-toggle" aria-expanded="false" aria-controls="docs-nav-items">
      <span class="docs-nav-label"><svg class="docs-nav-menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span>Browse documentation</span></span>
      <svg class="docs-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <div class="docs-nav-items" id="docs-nav-items">
    {% for group in navigation.groups %}
    <div class="nav-group">
      <p class="nav-group-label"><a href="/{{ group.path }}/"{% if page.url == "/" + group.path + "/" %} aria-current="page"{% endif %}>{{ group.group }}</a></p>
      <ul>
        {% for item in group.pages %}
        <li>
          {% if item.children %}
          {% set subgroupOpen = page.url in item.urls %}
          {% set subgroupId = "nav-" + (item.path | replace("/", "-")) %}
          <div class="nav-subgroup">
            <div class="nav-subgroup-row">
              <a href="/{{ item.path }}/"{% if page.url == "/" + item.path + "/" %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
              <button type="button" class="nav-subgroup-toggle" aria-expanded="{{ 'true' if subgroupOpen else 'false' }}" aria-controls="{{ subgroupId }}" aria-label="{{ item.title }} pages"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg></button>
            </div>
            <ul id="{{ subgroupId }}"{% if not subgroupOpen %} data-closed{% endif %}>
              {% for child in item.children %}
              <li><a href="/{{ child.path }}/"{% if page.url == "/" + child.path + "/" %} class="active" aria-current="page"{% endif %}>{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
          {% else %}
          <a href="/{{ item.path }}/"{% if page.url == "/" + item.path + "/" %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
    </div>
  </nav>

  <main id="main" class="doc-content">
    {% set trail = navigation.trails[page.url] %}
    {% if trail and trail.length > 1 %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {% for crumb in trail %}
        {% if loop.last %}
        <li><span aria-current="page">{{ crumb.title }}</span></li>
        {% else %}
        <li><a href="{{ crumb.url }}">{{ crumb.title }}</a></li>
        {% endif %}
        {% endfor %}
      </ol>
    </nav>
    <script type="application/ld+json">{{ {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": trail | breadcrumbListItems(site.url)
    } | dump | safe }}</script>
    {% endif %}
    {% if title %}
    <h1>{{ title }}</h1>
    {% endif %}

    {% if showToc %}
    <details class="toc-disclosure">
      <summary><span>On this page</span><svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary>
      <nav aria-label="On this page" class="toc-nav">
        {{ tocHtml | safe }}
      </nav>
    </details>
    {% endif %}

    {{ content | safe }}
  </main>

  {% if showToc %}
  <aside class="toc-rail">
    <nav aria-label="On this page" class="toc-nav">
      <p class="toc-label">On this page</p>
      {{ tocHtml | safe }}
    </nav>
  </aside>
  {% endif %}
</div>
{% endblock %}
