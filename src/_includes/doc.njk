{% extends "base.njk" %}

{# Render the TOC and count total entries (top-level + nested) via the
   plugin's own parser. The total-entry rule means a page with 1 H2 +
   many H3 children still renders the rail — see eleventy review fix. #}
{% set tocHtml = content | toc %}
{% set tocEntryCount = content | tocEntryCount %}
{% set showToc = tocEntryCount >= 2 %}

{% block bodyClass %}{% if not showToc %}no-toc{% endif %}{% if currentProduct.id == "relay-comments" and page.url == (currentProduct | versionForUrl(page.url)).url %} comments-overview{% endif %}{% endblock %}

{% block content %}
<div class="layout">
  <nav class="sidebar" aria-label="Documentation navigation">
    <button class="combined-nav-toggle" type="button" aria-expanded="false" aria-controls="combined-sidebar-scroll">Browse pages <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
    <div class="sidebar-scroll" id="combined-sidebar-scroll">
    {% for product in products %}
    {% set edition = product | versionForUrl(page.url) %}
    <section class="product-section{% if product.id == currentProduct.id %} product-section--current{% endif %}" data-product="{{ product.id }}" aria-labelledby="product-{{ product.id }}">
      <div class="product-heading-row">
        <h2 class="product-section-heading" id="product-{{ product.id }}">
          {% if product.status == 'shipped' %}
          <a href="{{ edition.url }}">{{ product.name }}</a>
          {% else %}<span aria-disabled="true">{{ product.name }}</span>{% endif %}
        </h2>
        {% include "product-version.njk" %}
      </div>
      {% if product.status == 'shipped' %}
      <div class="product-pages" id="pages-{{ product.id }}">
    {% for group in navigation.groups %}
    {% if group.productId == product.id and (group.version or product.version) == edition.label %}
    <div class="nav-group">
      {% if group.group != product.name %}
      <h3 class="nav-group-label"><a href="/{{ group.path }}/"{% if page.url == "/" + group.path + "/" %} class="active" aria-current="page"{% endif %}>{{ group.group }}</a></h3>
      {% endif %}
      <ul>
        {% if group.group == product.name %}
        <li><a href="{{ product.homePath }}"{% if page.url == product.homePath %} class="active" aria-current="page"{% endif %}>Overview</a></li>
        {% endif %}
        {% for item in group.pages %}
        <li>
          {% if item.children %}
          {% set subgroupOpen = page.url in item.urls %}
          {% set subgroupId = "nav-" + (item.path | replace("/", "-")) %}
          <div class="nav-subgroup">
            <div class="nav-subgroup-row">
              <a href="/{{ item.path }}/"{% if page.url == "/" + item.path + "/" %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
              <button type="button" class="nav-subgroup-toggle" aria-expanded="{{ 'true' if subgroupOpen else 'false' }}" aria-controls="{{ subgroupId }}" aria-label="{{ item.title }} pages"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg></button>
            </div>
            <ul id="{{ subgroupId }}"{% if not subgroupOpen %} data-closed{% endif %}>
              {% for child in item.children %}
              <li><a href="/{{ child.path }}/"{% if page.url == "/" + child.path + "/" %} class="active" aria-current="page"{% endif %}>{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
          {% else %}
          <a href="/{{ item.path }}/"{% if page.url == "/" + item.path + "/" %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
          {% endif %}
        </li>
        {% endfor %}
        {% for addition in product.navAdditions %}{% if addition.section == group.path %}
        <li><span class="nav-item-soon" aria-disabled="true">{{ addition.title }} <span class="product-version">Soon</span></span></li>
        {% endif %}{% endfor %}
      </ul>
    </div>
    {% endif %}
    {% endfor %}
      <a class="product-release-notes" href="{{ product.releaseNotesUrl }}">Release notes<span class="sr-only"> for {{ product.name }}</span></a>
      </div>
      {% endif %}
    </section>
    {% endfor %}
    <div class="sidebar-scroll-space" aria-hidden="true"></div>
    </div>
  </nav>
  {# Blocking script initializes the sidebar before it can be painted. #}
  <script src="/assets/js/combined-sidebar.js"></script>

  <main id="main" class="doc-content">
    {% set trail = navigation.trails[page.url] %}
    {% if trail and trail.length > 1 %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {% for crumb in trail %}
        {% if loop.last %}
        <li><span aria-current="page">{{ crumb.title }}</span></li>
        {% else %}
        <li><a href="{{ crumb.url }}">{{ crumb.title }}</a></li>
        {% endif %}
        {% endfor %}
      </ol>
    </nav>
    <script type="application/ld+json">{{ {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": trail | breadcrumbListItems(site.url)
    } | dump | safe }}</script>
    {% endif %}
    {% if title %}
    <h1>{{ title }}</h1>
    {% endif %}

    {% if showToc %}
    <details class="toc-disclosure">
      <summary><span>On this page</span><svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary>
      <nav aria-label="On this page" class="toc-nav">
        {{ tocHtml | safe }}
      </nav>
    </details>
    {% endif %}

    {% if page.url == "/" and products.length > 1 %}{% include "product-grid.njk" %}{% endif %}
    {{ content | safe }}
  </main>

  {% if showToc %}
  <aside class="toc-rail">
    <nav aria-label="On this page" class="toc-nav">
      <p class="toc-label">On this page</p>
      {{ tocHtml | safe }}
    </nav>
  </aside>
  {% endif %}
</div>
{% endblock %}
