{% macro responsiveClip(desktop, phone, desktopRatio, phoneRatio, title, linked = false) %}
<iframe data-clip-desktop="{{ desktop }}" data-clip-phone="{{ phone }}" style="--clip-desktop-ratio: {{ desktopRatio }}; --clip-phone-ratio: {{ phoneRatio }}" title="{{ title }}"{% if linked %} tabindex="-1"{% endif %}></iframe>
{% endmacro %}

