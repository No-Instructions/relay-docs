{% from "section-card.njk" import sectionCard %}
<p>Relay tools help people and agents work together on the same files. Use them separately or together.</p>
<ul class="section-cards" aria-label="Documentation products">
  {% for product in products %}
  <li data-product="{{ product.id }}">
    {% if product.status == 'shipped' %}
    {{ sectionCard(product.name, product.description, product.landingUrl) }}
    {% else %}
    <span class="section-card" aria-disabled="true"><span class="section-card-title">{{ product.name }}</span><span class="section-card-description">Coming soon</span></span>
    {% endif %}
  </li>
  {% endfor %}
</ul>

<h2>What do you want to do?</h2>
<ul>
  <li><a href="/guides/share-a-folder/">Share a folder with your team</a></li>
  <li><a href="/guides/invite-a-collaborator/#your-collaborator-joins">Join a folder someone shared with you</a></li>
  <li><a href="/comments/comment-on-a-note/#add-a-comment">Leave a comment on a passage</a></li>
  <li><a href="/comments/install-relay-comments/#install-with-an-agent">Have your agent install Relay Comments</a></li>
</ul>

<h2>Edit notes with your team in real time</h2>
<div class="home-editing-demo">
  <iframe data-comments-animation src="/assets/same-line-editing/framed-dbf0ac83/index.html?v=dbf0ac83" title="Two people editing the same line in an Obsidian note" loading="eager"></iframe>
</div>

<h2>Discuss a passage</h2>
<figure class="comments-thread-hero">
  <iframe data-comments-animation src="/assets/relay-comments/hero-claude-norelay-6735fb76/index.html?v=6735fb76" title="Adding a comment, replying, and resolving the thread in Obsidian"></iframe>
</figure>
